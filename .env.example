IMPALA_HOST=dein-impala-host.example.com
IMPALA_PORT=443
IMPALA_HTTP_PATH=cliservice
IMPALA_USER=dein-benutzername
IMPALA_PASSWORD=dein-passwort

# Optional für die Data Contract CLI.
# Die CLI liest .env automatisch, nutzt aber eigene Variablennamen fuer Impala.
DATACONTRACT_IMPALA_USERNAME=dein-benutzername
DATACONTRACT_IMPALA_PASSWORD=dein-passwort
DATACONTRACT_IMPALA_USE_SSL=true

# Nur für scheduler.py / pipeline_audit_to_target.py nötig (PySpark braucht JDK 17).
# Optional: nur setzen, wenn dein System-JAVA_HOME nicht schon auf ein
# JDK 17 zeigt. Pfad zu deiner lokalen JDK-17-Installation, z.B.:
# Windows:  C:\Users\<du>\AppData\Local\Programs\Eclipse Adoptium\jdk-17.x.x-hotspot
# Linux/Mac: /usr/lib/jvm/temurin-17-jdk
JAVA_HOME_JDK17=
DATABASE=
SOURCE_DATABASE=
PREFIX=
