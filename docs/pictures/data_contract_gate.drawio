<mxfile host="app.diagrams.net">
    <diagram id="page-contract-gate" name="Data-Contract-Durchsetzung (Publish-Gate)">
        <mxGraphModel dx="1167" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="g_title" value="Data Contract: technische Durchsetzung als Publish-Gate (Stufe 4/4)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="40" y="20" width="1320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="g_sub" value="Ein Datenstand, der den Vertrag verletzt, kann nicht still publiziert werden – der Lauf bricht sichtbar ab." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="56" width="1320" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="g_yaml" value="&lt;b&gt;data/data_contract.yaml&lt;/b&gt;&#xa;der Vertrag (Data Contract Specification 1.1.0)&#xa;Schema · required/primaryKey · terms · quality-SQLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
                    <mxGeometry x="560" y="110" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="g_pipe" value="&lt;b&gt;run_pipeline.py · Stufe 1→3&lt;/b&gt;&#xa;Staging → Audit → Star-Schema&#xa;gruppe3_dim_* / gruppe3_fact_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
                    <mxGeometry x="60" y="270" width="320" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="g_gate" value="&lt;b&gt;Stufe 4/4 · Publish-Gate&lt;/b&gt;&#xa;src/contract_check.py – prüft live gegen Impala:&#xa;① Schema exakt (auch keine Zusatzspalten)&#xa;② Pflichtfelder ohne NULL&#xa;③ Schlüssel duplikatfrei&#xa;④ Quality-SQLs (mustBe / mustBeGreaterThan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="560" y="250" width="340" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="g_ok" value="&lt;b&gt;✓ bestanden (32/32 Checks)&lt;/b&gt;&#xa;Datenprodukt am Output Port publiziert&#xa;Exit-Code 0 – Lauf erfolgreich" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
                    <mxGeometry x="1040" y="160" width="320" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="g_fail" value="&lt;b&gt;✗ Vertrag verletzt&lt;/b&gt;&#xa;Exit-Code 1 – Gesamtlauf schlägt sichtbar fehl&#xa;(Docker / Scheduler) · kein stiller Publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
                    <mxGeometry x="1040" y="410" width="320" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="g_e_read" value="liest (Quelle der Wahrheit)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#666666;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="g_yaml" target="g_gate" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g_e_gate" value="GATE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" parent="1" source="g_pipe" target="g_gate" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g_e_ok" value="alle Checks OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#82b366;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="g_gate" target="g_ok" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g_e_fail" value="≥ 1 Check fehlgeschlagen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#b85450;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="g_gate" target="g_fail" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="g_note" value="Derselbe Vertrag ist auch OHNE unseren Code extern prüfbar: datacontract lint ✓ (Spezifikation, CLI 1.0.10) · datacontract test --server production (Live-Test gegen den Output Port; Zugangsdaten via DATACONTRACT_IMPALA_USERNAME/-PASSWORD). Federated Computational Governance: die Regeln prüft ein Werkzeug bei jedem Lauf – nicht ein Meeting." style="text;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="40" y="600" width="1320" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
