                </mxCell>
                <mxCell id="p_l1" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;gruppe3_staging_*&lt;/b&gt;&lt;br&gt;unveränderte Rohkopie (1:1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="370" y="140" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p_l2" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;gruppe3_audit_*&lt;/b&gt;&lt;br&gt;bereinigte, saubere Basis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="700" y="140" width="250" height="120" as="geometry"/>
