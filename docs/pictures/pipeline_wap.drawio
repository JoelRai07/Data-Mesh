                <mxCell id="p_l3" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;gruppe3_dim_* / fact_*&lt;/b&gt;&lt;br&gt;Datenprodukt&amp;nbsp;&lt;br&gt;4 Dimensionen + 5 Fakten&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="140" width="250" height="120" as="geometry"/>
                </mxCell>
