    <diagram id="page-wap-concept" name="WAP-Muster (Konzept)">
        <mxGraphModel dx="1050" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="w_title" value="Write-Audit-Publish (WAP) – Muster und Abbildung auf das Datenprodukt" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="40" y="20" width="1120" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="w_sub" value="Prinzip: Daten erst isoliert schreiben, dann prüfen, und erst nach bestandener Prüfung veröffentlichen – so bekommen Konsumenten nie fehlerhafte Daten zu sehen." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="56" width="1120" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="w_write" value="&lt;b&gt;WRITE&lt;/b&gt;&#xa;&#xa;Neue/geänderte Daten in eine&#xa;&lt;b&gt;isolierte&lt;/b&gt; Fläche schreiben.&#xa;Die Produktion bleibt unberührt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
                    <mxGeometry x="60" y="140" width="320" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="w_audit" value="&lt;b&gt;AUDIT&lt;/b&gt;&#xa;&#xa;Qualität prüfen und bereinigen,&#xa;&lt;b&gt;bevor&lt;/b&gt; Konsumenten die&#xa;Daten sehen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
                    <mxGeometry x="440" y="140" width="320" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="w_pub" value="&lt;b&gt;PUBLISH&lt;/b&gt;&#xa;&#xa;Erst nach bestandener Prüfung&#xa;&lt;b&gt;atomar&lt;/b&gt; veröffentlichen –&#xa;der einzige Schritt am Output Port." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
                    <mxGeometry x="820" y="140" width="320" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="w_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="w_write" target="w_audit">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="w_audit" target="w_pub">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w_m1" value="&lt;b&gt;Hier: Schritt ①&lt;/b&gt;&#xa;pipeline_default_to_staging.py&#xa;→ gruppe3_staging_*&#xa;1:1-Rohkopie, getrennt von default.*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="60" y="340" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w_m2" value="&lt;b&gt;Hier: Schritt ② (+ ④)&lt;/b&gt;&#xa;pipeline_staging_to_audit.py&#xa;→ gruppe3_audit_* (Bereinigung + Iceberg-Merge)&#xa;contract_check.py = zusätzliches Quality-Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="440" y="340" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w_m3" value="&lt;b&gt;Hier: Schritt ③&lt;/b&gt;&#xa;pipeline_audit_to_target.py (Spark)&#xa;→ gruppe3_dim_* / gruppe3_fact_*&#xa;Star-Schema, TRUNCATE+INSERT, Output Port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="820" y="340" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="w_cm1" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#b0b0b0;" edge="1" parent="1" source="w_write" target="w_m1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w_cm2" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#b0b0b0;" edge="1" parent="1" source="w_audit" target="w_m2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w_cm3" style="edgeStyle=none;html=1;endArrow=none;dashed=1;strokeColor=#b0b0b0;" edge="1" parent="1" source="w_pub" target="w_m3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="w_note" value="Warum WAP? (1) Konsumenten sehen nie halbfertige/fehlerhafte Daten. (2) Fehler werden früh abgefangen (Audit + Gate), nicht erst im Produkt. (3) Publish ist atomar – entweder der neue Stand ist vollständig da oder gar nicht. Trade-off hier: das Star-Schema wird per TRUNCATE+INSERT neu gebaut, d.h. während des Rebuilds kann der Output Port kurz teilbefüllt sein (dokumentiert im Data Contract)." style="text;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="60" y="500" width="1080" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>