                    <mxGeometry x="30" y="130" width="1590" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p_l0" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;default.project_*&lt;/b&gt;&lt;br&gt;Rohdaten · 4 Quelltabellen&lt;br&gt;nur lesend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
